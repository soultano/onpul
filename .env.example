# ==========================================
# Zero One Academy AI - Environment Configuration
# ==========================================

# --- 1. MIRO API SETTINGS ---
# Получить персональный токен: https://miro.com/app/dashboard/?create_app=true
# Права (Scopes): boards:read, boards:write
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=uXjVHxGCWSc=

# --- 2. TELEGRAM SETTINGS ---
# Для получения статистики каналов и групп:
# 1) Telegram Bot Token (через @BotFather)
TELEGRAM_BOT_TOKEN=
# 2) Telegram API ID и HASH (https://my.telegram.org) - для парсинга просмотров и постов конкурентов
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_USERNAME=@zeroone_academy
TELEGRAM_COMMUNITY_CHAT_ID=

# --- 3. YOUTUBE API (Google Cloud Console) ---
# YouTube Data API v3 Key
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- 4. META (INSTAGRAM, FACEBOOK, THREADS) ---
# Meta Graph API Token (Facebook Developer Portal / Instagram Graph API)
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
THREADS_USER_ID=

# --- 5. CRM SETTINGS ---
# Выберите тип CRM: amocrm, bitrix24, hubspot, kommo
CRM_TYPE=amocrm
CRM_API_URL=https://yourcompany.amocrm.ru
CRM_ACCESS_TOKEN=

# --- 6. COMPETITORS TO TRACK ---
# Идентификаторы / каналы конкурентов через запятую
COMPETITORS_TELEGRAM=
COMPETITORS_YOUTUBE=
COMPETITORS_INSTAGRAM=
